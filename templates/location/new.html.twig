{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        body {
            padding: 2rem;
            background-color: #f8f9fa;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 2rem;
            background: #ffffff;
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
        }
    </style>
{% endblock %}

{% block title %}New Location{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="mb-4">Create new Location</h1>

        {{ include('location/_form.html.twig') }}

        <div class="mt-4">
            <a href="{{ path('app_location_index') }}" class="btn btn-secondary">back to list</a>
        </div>
    </div>
{% endblock %}
