{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        body {
            padding: 2rem;
            background-color: #f8f9fa;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
            background: #ffffff;
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
        }
    </style>
{% endblock %}

{% block title %}Forecast index{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="mb-4">Forecast index</h1>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Date</th>
                    <th>Temperature</th>
                    <th>Wind</th>
                    <th>Humidity</th>
                    <th>Precipitation</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for forecast in forecasts %}
                    <tr>
                        <td>{{ forecast.id }}</td>
                        <td>{{ forecast.date ? forecast.date|date('Y-m-d') : '' }}</td>
                        <td>{{ forecast.temperature }}</td>
                        <td>{{ forecast.wind }}</td>
                        <td>{{ forecast.humidity }}</td>
                        <td>{{ forecast.precipitation }}</td>
                        <td>
                            <div class="d-flex gap-2">
                                {% if is_granted('ROLE_FORECAST_SHOW') %}
                                    <a href="{{ path('app_forecast_show', {'id': forecast.id}) }}" class="btn btn-sm btn-info text-white">show</a>
                                {% endif %}
                                {% if is_granted('ROLE_FORECAST_EDIT') %}
                                    <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}" class="btn btn-sm btn-warning">edit</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4">
            {% if is_granted('ROLE_FORECAST_NEW') %}
                <a href="{{ path('app_forecast_new') }}" class="btn btn-primary">Create new</a>
            {% endif %}
            <a href="{{ path('app_location_index') }}" class="btn btn-secondary">View Location</a>
        </div>
    </div>
{% endblock %}
